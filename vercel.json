{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,.next,demo,tests,app_pages,backups,data,outbox,vault,applications,src,public}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/apply", "destination": "/api/index" },
    { "source": "/privacy", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 3 * * *" }
  ]
}
