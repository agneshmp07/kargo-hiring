# Copy to .env and fill in what you use. Never commit .env.

# Scoring: Claude (default) or Gemini
KARGO_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
KARGO_MODEL=claude-sonnet-5
# For Gemini: KARGO_LLM_PROVIDER=gemini, KARGO_MODEL=gemini-3.8-flash, and a key from aistudio.google.com/apikey.
# Real CVs are only sent when GEMINI_PAID_TIER=true (billing enabled): Google may use free-tier data.
GEMINI_API_KEY=
GEMINI_PAID_TIER=false

# Neon: paste the connection string from the Neon console (empty = local SQLite file)
DATABASE_URL=

# Encrypt names/emails at rest: python -m shortlister keygen
VAULT_KEY=

# Email safety. DRY_RUN stays true until you set it to false.
DRY_RUN=true
TEST_RECIPIENT=
TEST_WHATSAPP=

# Resend
RESEND_API_KEY=
FROM_EMAIL=Kargo Hiring <hiring@yourdomain.com>
# Where candidate replies go (e.g. Arjun or a shared hiring inbox)
REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Booking links (Cal.com or Calendly); per-role links override the shared one
SCHEDULING_LINK=
SCHEDULING_LINK_PM=
SCHEDULING_LINK_SPM=
CALCOM_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=

# WhatsApp via Twilio (only for candidates who opted in on the careers form)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Slack digest
SLACK_WEBHOOK_URL=

# Hiring inbox (IMAP; use an app password)
HIRING_IMAP_HOST=
HIRING_IMAP_USER=
HIRING_IMAP_PASSWORD=
HIRING_IMAP_FOLDER=INBOX

# Where the careers form / webhooks are reachable from the internet
PUBLIC_BASE_URL=http://localhost:8600
